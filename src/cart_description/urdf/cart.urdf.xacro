<?xml version="1.0"?>
<robot name="food_cart" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ============================================================ -->
  <!--  DIMENSIONS — measured on the real cart 2026-05-24 unless TODO  -->
  <!-- ============================================================ -->

  <!-- Chassis bounding box (meters). LxWxH. Footprint is a 0.725 m square.
       chassis_height is the RIGID body top, NOT the button-presser lift
       (that extends to 1.50 m above floor). -->
  <xacro:property name="chassis_length" value="0.725"/>
  <xacro:property name="chassis_width"  value="0.725"/>
  <xacro:property name="chassis_height" value="0.628"/>  <!-- frame top 67 cm AGL (0.042 + 0.628); camera rides ~4.6 cm above on a riser -->
  <xacro:property name="chassis_mass"   value="20.0"/>   <!-- TODO: measure -->

  <!-- base_link ground clearance: chassis underside off the floor (42 mm).
       The sensor z-heights below are measured from the floor and converted
       to base_link-relative by subtracting this. -->
  <xacro:property name="base_clearance" value="0.042"/>

  <!-- C1 lidar: centered on the cart, scan plane 193.155 mm above floor.
       z rel base_link = 0.193155 - 0.042. Its plane cuts through the swerve
       modules — see cart_bringup/config/scan_filter.yaml for the mask. -->
  <xacro:property name="lidar_xyz" value="0.0 0.0 0.151155"/>
  <!-- C1's 0-deg beam faces the cart's REAR, so yaw it 180 deg to align the
       scan with base_link +x (forward). The mask in scan_filter.yaml is in the
       lidar's own frame, so it is unaffected by this. -->
  <xacro:property name="lidar_rpy" value="0 0 3.14159"/>

  <!-- D455: 320.971 mm forward, 51.429 mm to the right (-y), 716.455 mm above
       floor, pitched 10 deg down. z rel base_link = 0.716455 - 0.042.
       camera_link x is the pointing axis; +pitch tilts it downward. -->
  <xacro:property name="camera_xyz" value="0.320971 -0.051429 0.674455"/>
  <xacro:property name="camera_rpy" value="0 0.174533 0"/>

  <!-- IMU mount (used for the RoboRIO Pigeon / NavX, NOT the D455 IMU). -->
  <xacro:property name="imu_xyz" value="0.0 0.0 0.0"/>
  <xacro:property name="imu_rpy" value="0 0 0"/>

  <!-- Colors -->
  <material name="cart_grey"><color rgba="0.4 0.4 0.45 1.0"/></material>
  <material name="lidar_black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="camera_blue"><color rgba="0.1 0.3 0.7 1.0"/></material>
  <material name="imu_red"><color rgba="0.7 0.1 0.1 1.0"/></material>

  <!-- ============================================================ -->
  <!--  base_footprint  (ground projection of base_link)             -->
  <!-- ============================================================ -->

  <link name="base_footprint"/>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_clearance}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================ -->
  <!--  base_link  (chassis)                                         -->
  <!-- ============================================================ -->

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="cart_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <inertia
        ixx="${chassis_mass*(chassis_width*chassis_width + chassis_height*chassis_height)/12}"
        iyy="${chassis_mass*(chassis_length*chassis_length + chassis_height*chassis_height)/12}"
        izz="${chassis_mass*(chassis_length*chassis_length + chassis_width*chassis_width)/12}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ============================================================ -->
  <!--  laser  (Slamtec C1)                                          -->
  <!--  Frame name 'laser' matches rplidar_ros default.              -->
  <!-- ============================================================ -->

  <joint name="base_to_laser" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="${lidar_xyz}" rpy="${lidar_rpy}"/>
  </joint>

  <link name="laser">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>
      <material name="lidar_black"/>
    </visual>
  </link>

  <!-- ============================================================ -->
  <!--  camera_link  (Intel RealSense D455)                          -->
  <!--  The realsense2_camera node publishes its own internal optical-->
  <!--  frames (camera_color_optical_frame, etc.) from camera_link.  -->
  <!-- ============================================================ -->

  <joint name="base_to_camera" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_xyz}" rpy="${camera_rpy}"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.124 0.029"/>
      </geometry>
      <material name="camera_blue"/>
    </visual>
  </link>

  <!-- ============================================================ -->
  <!--  imu_link  (RoboRIO IMU via NT bridge)                        -->
  <!-- ============================================================ -->

  <joint name="base_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_xyz}" rpy="${imu_rpy}"/>
  </joint>

  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.01"/>
      </geometry>
      <material name="imu_red"/>
    </visual>
  </link>

</robot>
